++                    sys.exit(0)
++
++        except subprocess.CalledProcessError as e:
++            print(f"Pipeline failed at {desc}. Exiting.")
++            sys.exit(1)
++
++    print("\nPipeline executed successfully. View results with 'python src/display_results.py'")
++
++if __name__ == "__main__":
++    main()
