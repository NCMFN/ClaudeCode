	account [label="Create an
Account" fillcolor="#add8e6" shape=box]
	fund [label="Fund the
Account" fillcolor="#add8e6" shape=box]
	order [label="Place an Order" fillcolor="#add8e6" shape=box]
	pool [label="Pool of cryptocurrencies" fillcolor="#add8e6" shape=box]
