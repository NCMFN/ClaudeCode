	exchange -> account
	account -> fund
	fund -> order
	order -> pool
	pool -> wavelet
	wavelet -> intensity
	intensity -> short [label="Period 64 to 256"]
	intensity -> medium [label="Period 8 to 32"]
	intensity -> long [label="Period 0 to 8"]
	short -> risk
	medium -> risk
	long -> risk
	risk -> sell_crit
	sell_crit -> sell [label=Yes color=green fontcolor=green]
	sell_crit -> relevant [label=No color=red fontcolor=red]
	relevant -> wavelet [label=Yes color=green fontcolor=green]
	relevant -> exit [label=No color=red fontcolor=red]
